# ============================================================================
# PRODUCTION environment — copy to `.env` on the deployment host and fill in.
# NEVER commit real secrets. `.env` is git-ignored; only this template is committed.
# Run:  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# ============================================================================

APP_ENV=production            # load-bearing: hides /docs, locks /config/model, disables the dev CORS regex
LOG_LEVEL=INFO

# ---- Model: OpenAI cloud for chat (no GPU needed) --------------------------
LLM_PROVIDER=cloud
AGENT_BACKEND=litellm         # direct, provider-agnostic path (most predictable in prod)
OPENAI_API_KEY=               # REQUIRED — a ROTATED key with a usage/budget cap set in the OpenAI dashboard
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings: OpenAI (pure-cloud, no Ollama). 1536 dims for text-embedding-3-small ----
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ---- CORS: requests are same-origin behind nginx, so this is only a safety net.
#      Set it to your real public URL. ----
CORS_ORIGINS=https://YOUR-APP.YOUR-DOMAIN.com

# ---- Database (Postgres + pgvector) ----------------------------------------
POSTGRES_USER=lenny
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=lenny
DATABASE_URL=postgresql://lenny:CHANGE_ME_STRONG@db:5432/lenny

# ---- LiteLLM proxy (only used if you switch AGENT_BACKEND=agent_sdk) --------
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=CHANGE_ME_PROXY_KEY

# ---- Retrieval / ingestion -------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
TRANSCRIPTS_REPO=https://github.com/ChatPRD/lennys-podcast-transcripts.git
INGEST_MAX_EPISODES=50
# Auto-populate the knowledge base on first boot when empty (great for Railway/PaaS,
# where running a one-off ingest command is awkward). Safe to leave on: it no-ops once loaded.
AUTO_INGEST=true

# ---- Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel) ----
TUNNEL_TOKEN=
